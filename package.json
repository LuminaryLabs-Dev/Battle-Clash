{
  "name": "battle-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A NexusEngine ECS dungeon-battle RPG greybox rendered with Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-approved-assets.mjs && vite build",
    "build:pages": "node scripts/prepare-approved-assets.mjs && vite build --outDir docs --emptyOutDir false",
    "check:domains": "node scripts/validate-domain-coverage.mjs",
    "check:release": "node scripts/validate-release.mjs",
    "check:pages-artifact": "node scripts/validate-pages-artifact.mjs",
    "check:auth": "node scripts/check-auth-contract.mjs",
    "check:sync": "node scripts/check-sync-contract.mjs",
    "check:peer": "node scripts/check-peer-contract.mjs",
    "check:all": "npm run check:domains && npm run check && npm run check:auth && npm run check:sync && npm run check:peer && npm run check:release && npm run build && npm run check:pages-artifact",
    "preview": "vite preview",
    "check": "node scripts/validate-simulation.mjs",
    "server": "node server/peer-server.mjs"
  },
  "dependencies": {
    "nexusengine": "https://codeload.github.com/LuminaryLabs-Dev/NexusEngine/tar.gz/d90dccb6bb23678a9cba0b7cac7351819f4f4eb0",
    "peer": "1.0.2",
    "peerjs": "1.5.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
