{
  "name": "battle-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A NexusEngine ECS dungeon-battle RPG greybox rendered with Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --outDir docs",
    "check:domains": "node scripts/validate-domain-coverage.mjs",
    "check:release": "node scripts/validate-release.mjs",
    "check:pages-artifact": "node scripts/validate-pages-artifact.mjs",
    "preview": "vite preview",
    "check": "node scripts/validate-simulation.mjs",
    "server": "node server/peer-server.mjs"
  },
  "dependencies": {
    "nexusengine": "https://codeload.github.com/LuminaryLabs-Dev/NexusEngine/tar.gz/d90dccb6bb23678a9cba0b7cac7351819f4f4eb0",
    "peer": "1.0.2",
    "peerjs": "1.5.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
