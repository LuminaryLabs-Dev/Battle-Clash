{
  "name": "battle-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A NexusEngine ECS dungeon-battle RPG greybox rendered with Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-release-tier.mjs && node scripts/prepare-approved-assets.mjs && vite build",
    "build:pages": "node scripts/prepare-release-tier.mjs && node scripts/prepare-approved-assets.mjs && vite build --outDir docs --emptyOutDir false",
    "check:domains": "node scripts/validate-domain-coverage.mjs",
    "check:tier": "node scripts/validate-tier-contract.mjs",
    "check:release": "node scripts/validate-release.mjs",
    "check:tier-flow": "node scripts/validate-tier-flow.mjs --mode=refs",
    "check:tier-baseline": "node scripts/validate-tier-flow.mjs --mode=baseline",
    "check:tier-promotion": "node scripts/validate-tier-flow.mjs --mode=promotion",
    "check:pages-artifact": "node scripts/validate-pages-artifact.mjs",
    "check:auth": "node scripts/check-auth-contract.mjs",
    "check:sync": "node scripts/check-sync-contract.mjs",
    "check:peer": "node scripts/check-peer-contract.mjs",
    "check:all": "npm run check:domains && npm run check:buildings && npm run check:tier && npm run check && npm run check:auth && npm run check:sync && npm run check:peer && npm run check:release && npm run build && npm run check:pages-artifact",
    "audit:tier": "node scripts/write-tier-audit.mjs",
    "preview": "vite preview",
    "check": "node scripts/validate-simulation.mjs",
    "server": "node server/peer-server.mjs",
    "review:headless": "node scripts/run-headless-editor-review.mjs",
    "generate:building": "node scripts/generate-procedural-building.mjs",
    "check:buildings": "node scripts/validate-building-system.mjs"
  },
  "dependencies": {
    "nexusengine": "https://codeload.github.com/LuminaryLabs-Dev/NexusEngine/tar.gz/c9218a79a84d8ea1980edef8a99df8918d688b6f",
    "peer": "1.0.2",
    "peerjs": "1.5.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
