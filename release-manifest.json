{
  "schema": "battle-clash.release/1",
  "project": "Battle Clash",
  "runtime": "Three.js + NexusEngine ECS",
  "requiredChecks": ["npm ci", "npm run check", "npm run check:domains", "npm run check:buildings", "npm run build", "git diff --check"],
  "deployment": {
    "provider": "github-pages",
    "sourceBranch": "main",
    "workflow": ".github/workflows/deploy.yml",
    "siteModel": "single-main-branch-pages-site",
    "productionUrl": "https://luminarylabs-dev.github.io/Battle-Clash/"
  },
  "tiers": "release-tiers.json",
  "online": { "identity": "supabase-auth", "transport": "peerjs", "durableApi": "rails" },
  "assets": { "catalog": "src/assets/approved-manifest.json", "fallback": "cube" },
  "audit": { "schema": "battle-clash.release-audit/1", "artifact": "battle-clash-release-audit", "healthCheck": "published-pages-entrypoint" },
  "secretsPolicy": "provider-encrypted-only"
}
